#include "aesdsocket.h"

struct timer_args {
    int interval_seconds;
    pthread_mutex_t* write_mutex;
}
void* timer_loop(void* arg) {
    struct timer_args* args = (struct timer_args*)arg;
    char buffer[128];
    while (stop_signal == 0) {
        sleep(args->interval_seconds);
        if (stop_signal == 1) {
            break;
        }
        // acquire the lock before getting the time, *probably* the correct thing to do?
        pthread_mutex_lock(args->write_mutex);
        time_t now = time(NULL);
        struct tm tm_info;
        localtime_r(&now, &tm_info);
        size_t str_len = strftime(&buffer, sizeof(buffer), "timestamp:%a, %d, %b, %Y, %H:%M:%S %z\n", &tm_info);
        if (str_len == 0) {
            syslog(LOG_ERR, "strftime failed");
            continue;
        }
        // write:
        int write_fd = open(WRITE_PATH, O_WRONLY | O_CREAT | O_APPEND, 0644);
        if (write_fd == -1) {
            syslog(LOG_ERR, "open %s: %s", WRITE_PATH, STRERROR);
            pthread_mutex_unlock(args->write_mutex);
            continue;
        }

        if (write_all(write_fd, &buffer, str_len) < 0) {
            syslog(LOG_ERR, "write: %s", STRERROR);
            close(write_fd);
            pthread_mutex_unlock(args->write_mutex);
            continue;
        }
        close(write_fd);
        pthread_mutex_unlock(args->write_mutex);
    }
    free(args);
    return NULL;
}

int start_timer_thread(int interval_seconds, pthread_t* pthread_id, pthread_mutex_t* write_mutex) {
    // args:
    struct timer_args* args = malloc(sizeof(*args));
    if (args == NULL) {
        syslog(LOG_ERR, "timer loop args: %s", STRERROR);
        return 1;
    }
    args->write_mutex = write_mutex;
    args->interval_seconds = interval_seconds;

    // create thread:
    if (pthread_create(pthread_id, NULL, timer_loop, args) != 0) {
        syslog(LOG_ERR, "pthread_create: %s", STRERROR);
        free(args);
        return 1;
    }
    return 0;
}